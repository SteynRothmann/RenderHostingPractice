# Copy this file to .env and fill in real values. Never commit .env itself.

# From your Spotify Developer Dashboard app
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match a "Redirect URI" registered in the Spotify Dashboard
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback

# Where the frontend runs, used to redirect the browser after login
FRONTEND_URL=http://localhost:5173

# Port for this Express server
PORT=3000

# Any long random string - used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_random_string

# Postgres connection string (from your team's hosted Postgres instance)
# e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@host:5432/dbname
